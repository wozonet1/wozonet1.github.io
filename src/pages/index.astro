---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latestNote = notes[0];
const { Content } = latestNote ? await render(latestNote) : { Content: null };
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
  weekday: "short",
});
---

<BaseLayout
  title="Wozonet"
  description="日常片段、长期兴趣，以及仍在形成的文章与项目。"
  pageClass="home-page"
  defaultTheme="light"
  lockTheme
>
  <section class="home-hero shell">
    <div class="welcome">
      <p class="kicker">A small place on the web</p>
      <h1>你好，这里是<br /><span>Wozonet 的个人角落。</span></h1>
      <p class="intro">
        我在这里留下偶然出现的念头，也整理那些值得花更久时间说明的事。
      </p>
    </div>

    {
      latestNote && Content ? (
        <a class="note-stack" href="/daily/" aria-label="查看今日记录与往日卡片">
          <span class="stack-card stack-third" aria-hidden="true" />
          <span class="stack-card stack-second" aria-hidden="true" />
          <article class="daily-card">
            <header>
              <div>
                <span class="card-label">今天的卡片</span>
                <time datetime={latestNote.data.date.toISOString()}>
                  {dateFormatter.format(latestNote.data.date)}
                </time>
              </div>
              <span class="card-number" aria-hidden="true">
                #{String(notes.length).padStart(3, "0")}
              </span>
            </header>
            <div class="daily-copy">
              <Content />
            </div>
            <footer>
              <span>{latestNote.data.weather ?? "一些正在发生的事"}</span>
              <strong>翻看往日卡片 <span aria-hidden="true">↗</span></strong>
            </footer>
          </article>
        </a>
      ) : (
        <div class="empty-card">第一张日常卡片正在路上。</div>
      )
    }
  </section>

  <section class="portrait shell" aria-labelledby="about-me">
    <div class="section-intro">
      <p class="section-index">01 / ABOUT</p>
      <h2 id="about-me">一个正在观察、写作，<br />也在动手制作东西的人。</h2>
      <p>
        下面的文字目前是原型占位。它们展示的不是一份标准简历，而是访客可以从哪些角度认识你。
      </p>
    </div>

    <div class="info-grid">
      <article class="info-card coral">
        <span class="info-icon" aria-hidden="true">⌁</span>
        <p class="info-label">现在的我</p>
        <h3>技术工作者，也是不太稳定的写作者。</h3>
        <p>关心工具怎样帮助人表达复杂的经验，同时努力保留那些不能被工具简化的部分。</p>
      </article>

      <article class="info-card sun">
        <span class="info-icon" aria-hidden="true">✦</span>
        <p class="info-label">长期兴趣</p>
        <h3>文学、审美、人文社科与创作工具。</h3>
        <ul>
          <li>作品如何建立自己的感知方式</li>
          <li>概念怎样进入日常判断</li>
          <li>技术如何改变创作过程</li>
        </ul>
      </article>

      <article class="info-card apricot">
        <span class="info-icon" aria-hidden="true">↗</span>
        <p class="info-label">正在做</p>
        <h3>把零散的想法变成可以继续生长的东西。</h3>
        <p>整理个人网站，尝试 AI 辅助的游戏剧本创作，也持续记录阅读和项目中的问题。</p>
      </article>

      <article class="info-card paper">
        <p class="info-label">一些经历</p>
        <div class="timeline">
          <div><time>现在</time><p>在技术与人文兴趣之间搭建自己的工作方式。</p></div>
          <div><time>此前</time><p>接触机器学习平台、工程实践与复杂项目协作。</p></div>
          <div><time>一直</time><p>阅读、写作，并试着准确地说明自己的感受。</p></div>
        </div>
      </article>
    </div>
  </section>

  <section class="start-here shell">
    <div>
      <p class="section-index">02 / START HERE</p>
      <h2>如果想再多了解一点</h2>
    </div>
    <nav class="start-links" aria-label="推荐入口">
      <a href="/daily/"><span>01</span><strong>日常片段</strong><em>短小、即时、不必完整</em><b>→</b></a>
      <a href="/posts/"><span>02</span><strong>长篇文字</strong><em>随笔、分析与较完整的思考</em><b>→</b></a>
      <a href="/about/"><span>03</span><strong>关于这里</strong><em>网站的计划与写作方式</em><b>→</b></a>
    </nav>
  </section>
</BaseLayout>

<style>
  :global(body.home-page) {
    --home-ink: oklch(0.2787 0.0219 57.72);
    --home-muted: oklch(0.5233 0.0325 61.83);
    --home-orange: oklch(0.703 0.1941 39.49);
    --home-yellow: oklch(0.76 0.17 78);
    --home-cream: oklch(0.9865 0.013 82.4);
    color-scheme: only light;
    background:
      radial-gradient(
        circle at 8% 8%,
        oklch(0.713 0.213 62.92 / 0.7),
        transparent 27rem
      ),
      radial-gradient(
        circle at 92% 22%,
        oklch(0.776 0.157 79 / 0.5),
        transparent 31rem
      ),
      var(--home-yellow);
    color: var(--home-ink);
  }

  :global(body.home-page)::before {
    opacity: 0;
  }

  :global(body.home-page .site-footer) {
    border-color: oklch(0.3359 0.0471 53.62 / 0.15);
    color: var(--home-muted);
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(15rem, 0.72fr) minmax(30rem, 1.28fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 8rem);
    min-height: min(48rem, calc(100vh - 4.25rem));
    padding-block: 5.5rem 7rem;
  }

  .kicker,
  .section-index {
    margin: 0 0 1rem;
    color: oklch(0.5625 0.1581 38.11);
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  h1 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.8rem, 5.3vw, 5.2rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.08;
  }

  h1 span {
    color: var(--home-orange);
  }

  .intro {
    max-width: 28rem;
    margin: 1.75rem 0 0;
    color: var(--home-muted);
    font-family: var(--serif);
    font-size: 1.05rem;
  }

  .note-stack {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
    isolation: isolate;
  }

  .stack-card,
  .daily-card {
    border: 1px solid oklch(0.3495 0.0629 56.18 / 0.13);
    border-radius: 1.5rem;
  }

  .stack-card {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: oklch(0.8823 0.1345 86.55);
    transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 260ms ease;
  }

  .stack-second {
    background: oklch(0.80 0.12 55);
    transform: translate(0.55rem, 0.55rem) rotate(0.25deg);
  }

  .stack-third {
    background: oklch(0.67 0.075 285);
    transform: translate(1rem, 1rem) rotate(0.5deg);
  }

  .daily-card {
    min-height: 25rem;
    padding: clamp(1.5rem, 4vw, 2.8rem);
    background:
      linear-gradient( oklch(0.63 0.21 38), oklch(0.672 0.21 38)),
      repeating-linear-gradient(
        0deg,
        transparent 0 2rem,
        oklch(0.3333 0.0868 39.52 / 0.08) 2rem calc(2rem + 1px)
      ),
      oklch(0.7299 0.1768 45.14);
    box-shadow: 0 1.2rem 3.4rem oklch(0.4834 0.1191 46.71 / 0.16);
    transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 260ms ease;
  }

  .note-stack:hover .daily-card,
  .note-stack:focus-visible .daily-card {
    transform: translate(-0.45rem, -0.55rem) rotate(-0.35deg);
    box-shadow: 1.4rem 1.8rem 3.8rem oklch(0.4239 0.0842 54.26 / 0.2);
  }

  .note-stack:hover .stack-second,
  .note-stack:focus-visible .stack-second {
    transform: translate(0.85rem, 0.9rem) rotate(1.2deg);
  }

  .note-stack:hover .stack-third,
  .note-stack:focus-visible .stack-third {
    transform: translate(1.55rem, 1.55rem) rotate(2deg);
    box-shadow: 0.8rem 1.1rem 2rem oklch(0.4268 0.0841 268.97 / 0.18);
  }

  .note-stack:focus-visible {
    border-radius: 1.5rem;
    outline: 3px solid var(--home-orange);
    outline-offset: 0.8rem;
  }

  .daily-card header,
  .daily-card footer {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-label,
  .daily-card time {
    display: block;
  }

  .card-label {
    margin-bottom: 0.25rem;
    color: oklch(0.3739 0.11 36.58);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  .daily-card time,
  .card-number {
    color: oklch(0.3034 0.0616 42.19 / 0.68);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .daily-copy {
    display: grid;
    min-height: 14rem;
    align-content: center;
    max-width: 28ch;
    margin: 1.5rem auto;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2.7vw, 1.8rem);
    line-height: 1.75;
  }

  .daily-copy :global(p) {
    margin: 0;
  }

  .daily-card footer {
    align-items: end;
    padding-top: 1.2rem;
    border-top: 1px solid oklch(0.327 0.0739 43.29 / 0.2);
    color: oklch(0.3034 0.0616 42.19 / 0.72);
    font-size: 0.72rem;
  }

  .daily-card footer strong {
    color: var(--home-ink);
    font-size: 0.76rem;
  }

  .portrait {
    padding-block: 7rem;
    border-top: 1px solid oklch(0.3359 0.0471 53.62 / 0.14);
  }

  .section-intro {
    display: grid;
    grid-template-columns: 10rem minmax(20rem, 1fr) minmax(15rem, 0.55fr);
    align-items: end;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .section-intro h2,
  .start-here h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.1rem, 4vw, 3.8rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.15;
  }

  .section-intro > p:last-child {
    margin: 0;
    color: var(--home-muted);
    font-size: 0.85rem;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1rem;
  }

  .info-card {
    min-height: 19rem;
    padding: 2rem;
    border: 1px solid oklch(0.3359 0.0471 53.62 / 0.12);
    border-radius: 1.4rem;
  }

  .info-card:nth-child(1),
  .info-card:nth-child(2) {
    grid-column: span 6;
  }

  .info-card:nth-child(3) {
    grid-column: span 5;
  }

  .info-card:nth-child(4) {
    grid-column: span 7;
  }

  .coral { background: oklch(0.728 0.172 37.74); }
  .sun { background: oklch(0.8819 0.1377 87.16); }
  .apricot { background: oklch(0.8562 0.0886 52.28); }
  .paper { background: oklch(1 0 0 / 0.68); }

  .info-icon {
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    margin-bottom: 3rem;
    border: 1px solid oklch(0.2787 0.0219 57.72 / 0.25);
    border-radius: 50%;
    font-size: 1.15rem;
  }

  .info-label {
    margin: 0 0 0.7rem;
    font-family: var(--mono);
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .info-card h3 {
    max-width: 22ch;
    margin: 0 0 1rem;
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.7vw, 2rem);
    line-height: 1.28;
  }

  .info-card > p:last-child,
  .info-card li {
    max-width: 44ch;
    font-size: 0.86rem;
  }

  .info-card ul {
    margin: 1.5rem 0 0;
    padding-left: 1.2rem;
  }

  .timeline {
    display: grid;
    gap: 0;
    margin-top: 1.2rem;
  }

  .timeline > div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid oklch(0.2787 0.0219 57.72 / 0.14);
  }

  .timeline time {
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .timeline p {
    margin: 0;
    font-size: 0.85rem;
  }

  .start-here {
    display: grid;
    grid-template-columns: minmax(15rem, 0.55fr) 1fr;
    gap: 5rem;
    padding-block: 7rem 9rem;
  }

  .start-links {
    display: grid;
  }

  .start-links a {
    display: grid;
    grid-template-columns: 2rem 1fr 1.25fr auto;
    align-items: center;
    gap: 1.2rem;
    padding-block: 1.5rem;
    border-top: 1px solid oklch(0.3359 0.0471 53.62 / 0.18);
    text-decoration: none;
    transition: padding 180ms ease, color 180ms ease;
  }

  .start-links a:last-child {
    border-bottom: 1px solid oklch(0.3359 0.0471 53.62 / 0.18);
  }

  .start-links a:hover {
    padding-inline: 0.5rem;
    color: oklch(0.57 0.1708 36.67);
  }

  .start-links span,
  .start-links em {
    color: var(--home-muted);
    font-size: 0.73rem;
    font-style: normal;
  }

  .start-links strong {
    font-family: var(--serif);
    font-size: 1.1rem;
  }

  .start-links b {
    font-size: 1.2rem;
  }

  @media (max-width: 58rem) {
    .home-hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 4rem;
    }

    .welcome {
      max-width: 40rem;
    }

    .note-stack {
      width: calc(100% - 1rem);
    }

    .section-intro {
      grid-template-columns: 1fr;
    }

    .section-intro > p:last-child {
      max-width: 34rem;
    }

    .start-here {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 42rem) {
    .home-hero {
      gap: 3rem;
      padding-block: 3.5rem 5.5rem;
    }

    .daily-card {
      min-height: 23rem;
      padding: 1.4rem;
    }

    .daily-copy {
      min-height: 13rem;
      font-size: 1.25rem;
    }

    .daily-card footer span:first-child {
      display: none;
    }

    .info-card,
    .info-card:nth-child(n) {
      grid-column: 1 / -1;
      min-height: auto;
    }

    .info-icon {
      margin-bottom: 2rem;
    }

    .start-links a {
      grid-template-columns: 1.5rem 1fr auto;
    }

    .start-links em {
      display: none;
    }
  }
</style>
