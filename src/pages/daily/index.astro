---
import { getCollection, render } from "astro:content";
import DailyNoteEntry from "../../components/DailyNoteEntry.astro";
import MomentStrip from "../../components/MomentStrip.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { groupDailyEntriesByDay } from "../../utils/moments";

const [momentEntries, noteEntries] = await Promise.all([
  getCollection("moments", ({ data }) => !data.draft),
  getCollection("dailyNotes", ({ data }) => !data.draft),
]);
const days = groupDailyEntriesByDay(momentEntries, noteEntries);
const renderedDays = await Promise.all(
  days.map(async (day) => ({
    ...day,
    items: await Promise.all(
      day.items.map(async (item) => ({
        ...item,
        Content: (await render(item.entry)).Content,
      })),
    ),
  })),
);
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  timeZone: "Asia/Shanghai",
  year: "numeric",
  month: "long",
  day: "numeric",
  weekday: "short",
});
---

<BaseLayout
  title="日常记录"
  description="一天是一张横线纸，短暂的状态与较长的随记按时间留在同一页上。"
  pageClass="daily-page"
  defaultTheme="light"
  lockTheme
>
  <section class="daily-archive shell">
    <header class="archive-header">
      <div>
        <p>
          DAILY NOTES · {momentEntries.length} MOMENTS + {noteEntries.length} NOTES / {days.length} DAYS
        </p>
        <h1>留在这里的日子</h1>
      </div>
      <p class="archive-description">
        状态是一张临时贴下的纸条，随记则直接写在当天的横线纸上。
        它们会按出现的时刻回到同一天里。
      </p>
    </header>

    <div class="paper-wall">
      {
        renderedDays.map((day) => (
          <article class="day-paper">
            <header class="paper-heading">
              <div>
                <p>{day.weather ?? "一些被留下的时刻"}</p>
                <h2>
                  <a href={`/daily/${day.key}/`}>{dateFormatter.format(day.date)}</a>
                </h2>
              </div>
              <span>{String(day.items.length).padStart(2, "0")} 条记录</span>
            </header>

            <div class="paper-moments">
              {
                day.items.map((item, index) =>
                  item.kind === "moment" ? (
                    <MomentStrip
                      moment={item}
                      Content={item.Content}
                      index={index}
                      compact
                    />
                  ) : (
                    <DailyNoteEntry note={item} Content={item.Content} compact />
                  ),
                )
              }
            </div>

            <footer class="paper-footer">
              <div>
                {day.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
              </div>
              <a href={`/daily/${day.key}/`}>
                拿下来细看 <span aria-hidden="true">↗</span>
              </a>
            </footer>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  :global(body.daily-page) {
    --daily-ink: oklch(0.2787 0.0219 57.72);
    --daily-muted: oklch(0.5233 0.0325 61.83);
    color-scheme: only light;
    background:
      radial-gradient(
        circle at 12% 4%,
        oklch(0.86 0.11 76 / 0.34),
        transparent 28rem
      ),
      radial-gradient(
        circle at 88% 30%,
        oklch(0.74 0.075 285 / 0.14),
        transparent 32rem
      ),
      oklch(0.9 0.045 84);
    color: var(--daily-ink);
  }

  :global(body.daily-page)::before {
    opacity: 0;
  }

  :global(body.daily-page .site-footer) {
    border-color: oklch(0.3359 0.0471 53.62 / 0.15);
    color: var(--daily-muted);
  }

  .daily-archive {
    padding-block: 5.5rem 9rem;
  }

  .archive-header {
    display: grid;
    grid-template-columns: 1fr minmax(18rem, 0.48fr);
    align-items: end;
    gap: 3rem;
    margin-bottom: 4.5rem;
  }

  .archive-header > div > p {
    margin: 0 0 1rem;
    color: oklch(0.5625 0.1581 38.11);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    max-width: 9ch;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(3.2rem, 7vw, 6.4rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 1.05;
  }

  .archive-description {
    margin: 0;
    color: var(--daily-muted);
    font-family: var(--serif);
    line-height: 1.9;
  }

  .paper-wall {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .day-paper {
    position: relative;
    min-height: 27rem;
    padding: clamp(1.5rem, 3vw, 2.3rem) clamp(1.4rem, 3vw, 2.2rem) 3.2rem;
    clip-path: polygon(
      0 0,
      100% 0,
      100% 97.8%,
      96% 99.5%,
      91% 97.9%,
      86% 99.7%,
      80% 98.1%,
      74% 99.5%,
      68% 98%,
      61% 99.8%,
      54% 98.2%,
      47% 99.6%,
      40% 98.1%,
      33% 99.7%,
      26% 98.2%,
      19% 99.6%,
      12% 98%,
      6% 99.4%,
      0 98%
    );
    background:
      repeating-linear-gradient(
        to bottom,
        transparent 0 2.1rem,
        oklch(0.62 0.055 245 / 0.17) 2.1rem calc(2.1rem + 1px)
      ),
      oklch(0.984 0.012 88);
    box-shadow: 0 1.4rem 3rem oklch(0.35 0.055 55 / 0.14);
  }

  .day-paper:nth-child(4n + 2) {
    transform: rotate(0.35deg);
  }

  .day-paper:nth-child(4n + 3) {
    transform: rotate(-0.28deg);
  }

  .paper-heading,
  .paper-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .paper-heading {
    align-items: start;
    margin-bottom: 2.2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid oklch(0.3359 0.0471 53.62 / 0.12);
  }

  .paper-heading p {
    margin: 0 0 0.25rem;
    color: var(--daily-muted);
    font-family: var(--mono);
    font-size: 0.64rem;
  }

  .paper-heading h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
    line-height: 1.3;
  }

  .paper-heading h2 a {
    text-decoration: none;
  }

  .paper-heading h2 a:hover {
    color: oklch(0.57 0.1708 36.67);
  }

  .paper-heading > span {
    color: var(--daily-muted);
    font-family: var(--mono);
    font-size: 0.63rem;
    white-space: nowrap;
  }

  .paper-moments {
    display: grid;
    gap: 1.15rem;
  }

  .paper-footer {
    align-items: end;
    margin-top: 2.4rem;
    padding-top: 1rem;
    border-top: 1px solid oklch(0.3359 0.0471 53.62 / 0.12);
    color: var(--daily-muted);
    font-size: 0.68rem;
  }

  .paper-footer > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .paper-footer > a {
    color: var(--daily-ink);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (max-width: 48rem) {
    .daily-archive {
      padding-block: 4rem 6rem;
    }

    .archive-header,
    .paper-wall {
      grid-template-columns: 1fr;
    }

    .archive-header {
      gap: 2rem;
      margin-bottom: 3rem;
    }

    .archive-description {
      max-width: 34rem;
    }

    .day-paper {
      min-height: 23rem;
    }
  }
</style>
