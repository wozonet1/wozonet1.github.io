---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const renderedNotes = await Promise.all(
  notes.map(async (note) => ({ note, Content: (await render(note)).Content })),
);
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
  weekday: "short",
});
---

<BaseLayout
  title="日常卡片"
  description="按日期存放的短小感受、观察与生活片段。"
  pageClass="daily-page"
  defaultTheme="light"
  lockTheme
>
  <section class="daily-archive shell">
    <header class="archive-header">
      <div>
        <p>DAILY NOTES · {notes.length} CARDS</p>
        <h1>往日卡片</h1>
      </div>
      <p class="archive-description">
        这里保存短小、即时、不必完整的记录。它们按日期排列，但不要求每天都出现。
      </p>
    </header>

    <div class="card-list">
      {
        renderedNotes.map(({ note, Content }, index) => (
          <article class="archive-card" style={`--card-index: ${index}`}>
            <header>
              <time datetime={note.data.date.toISOString()}>
                {dateFormatter.format(note.data.date)}
              </time>
              <span>{note.data.weather ?? "日常"}</span>
            </header>
            <h2>{note.data.title}</h2>
            <div class="note-content">
              <Content />
            </div>
            {note.data.tags.length > 0 && (
              <footer>{note.data.tags.map((tag) => <span>#{tag}</span>)}</footer>
            )}
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  :global(body.daily-page) {
    --daily-ink: oklch(0.2787 0.0219 57.72);
    --daily-muted: oklch(0.5233 0.0325 61.83);
    --daily-line: oklch(0.3359 0.0471 53.62);
    color-scheme: only light;
    background:
      radial-gradient(
        circle at 8% 4%,
        oklch(0.8783 0.1351 85.57 / 0.22),
        transparent 28rem
      ),
      oklch(0.9865 0.013 82.4);
    color: var(--daily-ink);
  }

  :global(body.daily-page)::before {
    opacity: 0;
  }

  :global(body.daily-page .site-footer) {
    border-color: oklch(0.3359 0.0471 53.62 / 0.15);
    color: var(--daily-muted);
  }

  .daily-archive {
    padding-block: 6rem 9rem;
  }

  .archive-header {
    display: grid;
    grid-template-columns: 1fr minmax(18rem, 0.5fr);
    align-items: end;
    gap: 3rem;
    margin-bottom: 5rem;
  }

  .archive-header > div > p {
    color: oklch(0.5625 0.1581 38.11);
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(3.5rem, 8vw, 7rem);
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .archive-description {
    margin: 0;
    color: var(--daily-muted);
    font-family: var(--serif);
  }

  .card-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .archive-card {
    min-height: 24rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid oklch(0.3495 0.0629 56.18 / 0.13);
    border-radius: 1.4rem;
    background: oklch(0.9942 0.0069 88.64);
    box-shadow: 0 0.8rem 2.4rem oklch(0.4239 0.0842 54.26 / 0.08);
  }

  .archive-card:nth-child(4n + 2) { background: oklch(0.8867 0.1322 87.23); }
  .archive-card:nth-child(4n + 3) { background: oklch(0.8562 0.0886 52.28); }
  .archive-card:nth-child(4n + 4) { background: oklch(0.7799 0.1324 38.51); }

  .archive-card > header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--daily-muted);
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  .archive-card h2 {
    margin: 4rem 0 1rem;
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .note-content {
    max-width: 32ch;
    font-family: var(--serif);
    font-size: clamp(1.12rem, 2vw, 1.45rem);
    line-height: 1.75;
  }

  .note-content :global(p) {
    margin: 0;
  }

  .archive-card footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
    color: var(--daily-muted);
    font-size: 0.68rem;
  }

  @media (max-width: 44rem) {
    .daily-archive {
      padding-block: 4rem 6rem;
    }

    .archive-header {
      grid-template-columns: 1fr;
      gap: 2rem;
      margin-bottom: 3rem;
    }

    .card-list {
      grid-template-columns: 1fr;
    }

    .archive-card {
      min-height: 21rem;
    }
  }
</style>
