---
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "首页" },
  { href: "/posts/", label: "文章" },
  { href: "/tags/", label: "主题" },
  { href: "/about/", label: "关于" },
];
---

<header class="site-header">
  <div class="shell nav-shell">
    <a class="brand" href="/" aria-label="Wozonet 首页">
      <span class="brand-mark" aria-hidden="true"></span>
      <span>wozonet</span>
    </a>
    <nav aria-label="主导航">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={
              path === link.href || (link.href !== "/" && path.startsWith(link.href))
                ? "page"
                : undefined
            }
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换到浅色模式">
      <span aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 30;
    top: 0;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(18px);
  }

  .nav-shell {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.6rem;
    font-family: var(--mono);
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-decoration: none;
  }

  .brand-mark {
    width: 0.72rem;
    height: 0.72rem;
    border: 1px solid var(--accent);
    border-radius: 50%;
    box-shadow: inset 0 0 0 0.2rem var(--bg), inset 0 0 0 0.5rem var(--accent);
  }

  nav {
    display: flex;
    gap: 1.5rem;
  }

  nav a {
    position: relative;
    padding-block: 1.35rem;
    color: var(--text-soft);
    font-size: 0.78rem;
    text-decoration: none;
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 1px;
    transform: scaleX(0);
    background: var(--accent);
    content: "";
    transition: transform 160ms ease;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--text);
  }

  nav a:hover::after,
  nav a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .theme-toggle {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    justify-self: end;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .theme-toggle span {
    width: 0.8rem;
    height: 0.8rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }

  @media (max-width: 42rem) {
    .nav-shell {
      grid-template-columns: 1fr auto;
    }

    nav {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 40;
      justify-content: space-around;
      gap: 0;
      border-top: 1px solid var(--line);
      background: color-mix(in srgb, var(--bg) 92%, transparent);
      backdrop-filter: blur(18px);
    }

    nav a {
      flex: 1;
      padding-block: 0.85rem;
      text-align: center;
    }

    nav a::after {
      top: -1px;
      bottom: auto;
    }

  }
</style>
